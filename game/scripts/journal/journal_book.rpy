########################
# region Journal Book  #
########################

screen journal_backdrop():
    # """
    # The map stays visible behind the journal, blurred and dimmed so the
    # book reads as lying on top of it.
    # """

    if journal_title_mode():
        # opened from the title screen: its (possibly animated) background, blurred
        add gui.main_menu_background at jr_map_blur
        add "gui/journal/ui/backdrop.webp"
    elif journal_in_game_menu():
        # opened mid event: the moment the menu was opened, blurred (the screenshot
        # Ren'Py takes for save thumbnails); no live stats, nothing to click behind
        add Transform(journal_menu_screenshot(), xysize = (1920, 1080)) at jr_map_blur
        add "gui/journal/ui/backdrop.webp"
    else:
        add map_manager.get_current_map().get_map_path() at jr_map_blur
        add "gui/journal/ui/backdrop.webp"
        # above the dimming so the stats stay readable; the book is drawn later and still covers it
        use school_overview_stats(show_navigation = False, show_tooltip = False)

screen journal_ribbon(key, side, y, active, action, tooltip_text, usable = True):
    # """
    # One navigation bookmark. Its root hides ~30px under the page layer, so
    # the sprite is placed relative to the page edge, not to its own tip.
    # """

    $ state = "active" if active else "idle"
    $ length = 146 if active else 112
    $ pad = 14
    $ x = 300 - (length + pad) if side == "l" else 1620 - pad
    $ ribbon_image = "gui/journal/ribbons/{}_{}_{}.webp".format(key, state, side)
    if journal_section_has_alert(key):
        # a "new" sticker on the ribbon's free end; part of the button image so it
        # slides out with the ribbon on hover
        $ pin_x = pad + 6 if side == "l" else pad + length - 6 - 30
        $ ribbon_image = Fixed(ribbon_image, Transform("gui/journal/ui/alert_pin.webp", pos = (pin_x, 0)), fit_first = True)

    imagebutton:
        idle ribbon_image
        pos (x, y - 44)
        focus_mask True
        if not usable:
            # greyed out: the page can't be opened from here (game menu mid event)
            at Transform(alpha = 0.45, matrixcolor = SaturationMatrix(0.3))
        elif not active:
            at jr_ribbon_slide(-10 if side == "l" else 10)
        action action
        tooltip tooltip_text

screen journal_ribbon_stub(key, side, y, active):
    # """
    # End of a side ribbon glued onto the page: a 40px stub that covers the
    # page-stack edge (x 268-280 left, 1640-1652 right) and 28px of paper,
    # inside a 14px shadow pad; see STUB_SIDE in build_ribbons.py.
    # """

    $ state = "active" if active else "idle"
    $ x = 268 - 14 if side == "l" else 1652 - 40 - 14
    add "gui/journal/ribbons/stub_{}_{}_{}.webp".format(key, state, side) pos (x, y - 30 - 14)

screen journal_sub_ribbons(section, entries):
    # """
    # Sub-page bookmarks along the top edge, coloured like their section.
    #
    # ### Parameters:
    # 1. section: str
    #     - ribbon colour key of the parent section
    # 2. entries: List[Tuple[str, bool, Action]]
    #     - label, whether it is the open sub page, action
    # """

    for i, (label, active, action) in enumerate(entries):
        $ state = "active" if active else "idle"
        # sprite = ribbon length + 2*14px shadow pad; its root hides 30px under the page top (y 150)
        $ height = 132 if active else 112
        $ xcenter = 390 + i * 140
        button:
            background "gui/journal/ribbons/sub_{}_{}.webp".format(section, state)
            xysize (146, height)
            pos (xcenter - 73, 194 - height)
            padding (0, 0, 0, 0)
            focus_mask True
            if not active:
                at jr_sub_slide
            action action
            text label:
                font JR_FONT_SEMIBOLD
                size 20
                color "#f0e4cc"
                outlines [(1, "#00000040", 0, 1)]
                xalign 0.5
                # centred on the part that sticks out above the page
                ypos int((height - 32) / 2 - 12)

screen journal_book(page, display, sub_entries = None):
    # """
    # Book layers and ribbon navigation shared by all journal pages.
    #
    # sub_entries: optional sub-page bookmarks along the top edge,
    # see journal_sub_ribbons.
    # """

    $ section = JOURNAL_PAGE_SECTION.get(page, "")
    $ show_keys = has_keyboard() and show_shortcut()

    add "gui/journal/book_cover.webp"

    $ in_game_menu = journal_in_game_menu()
    $ title_mode = journal_title_mode()

    for side in ("l", "r"):
        for row, (nav_key, title, target, digit) in enumerate(journal_nav_entries(side)):
          # before a game runs only the menu and the credits exist (no greyed ribbons)
          if not title_mode or nav_key in JOURNAL_TITLE_SECTIONS:
              $ usable = target is not None and (not in_game_menu or nav_key in JOURNAL_GAME_MENU_SECTIONS)
              if not usable:
                  $ ribbon_action = NullAction()
              elif title_mode:
                  $ ribbon_action = ShowMenu("journal_title", ("credits" if nav_key == "credits" else "load"))
              else:
                  $ ribbon_action = [With(dissolveM), Call("open_journal", target, "")]
              $ ribbon_tip = title + (" [[" + digit + "]" if digit and show_keys else "")
              if in_game_menu and not usable:
                  $ ribbon_tip = title + " (only on the map)"
              use journal_ribbon(nav_key, side, JOURNAL_RIBBON_ROWS[row], (nav_key == section), ribbon_action, ribbon_tip, usable)

              if digit and has_keyboard() and nav_key != section and usable:
                  key ("K_" + digit) action ribbon_action
                  key ("K_KP" + digit) action ribbon_action

    use journal_ribbon("exit", "r", JOURNAL_EXIT_ROW, False,
        journal_close_action(), ("Back to the title" if title_mode else "Back to the game" if in_game_menu else "Close Journal") + (" [[ESC]" if show_keys else ""))

    if sub_entries:
        use journal_sub_ribbons(section, sub_entries)

    add "gui/journal/book_pages.webp"

    for doodle, doodle_x, doodle_y in JOURNAL_DOODLES.get(section, []):
        add "gui/journal/doodles/{}.webp".format(doodle) pos (doodle_x, doodle_y) alpha 0.85

    # Only the bookmark of the open section is glued to this spread, so only its end
    # lies on the paper (above the page layer); the others vanish between the leaves.
    for side in ("l", "r"):
        for row, (nav_key, title, target, digit) in enumerate(journal_nav_entries(side)):
            if nav_key == section:
                use journal_ribbon_stub(nav_key, side, JOURNAL_RIBBON_ROWS[row], True)
    if sub_entries:
        for i, (label, active, action) in enumerate(sub_entries):
            if active:
                add "gui/journal/ribbons/stub_sub_{}_active.webp".format(section):
                    # page top edge at y 150; the stub wraps 4px over it
                    pos (390 + i * 140 - 59 - 14, 150 - 4 - 14)

screen journal_tooltip():
    # """
    # Tooltips as small paper slips next to the hovered element.
    # """

    $ tooltip = GetTooltip()
    if tooltip:
        nearrect:
            focus "tooltip"
            prefer_top True

            frame:
                style "jr_tooltip_frame"
                xalign 0.5
                text tooltip style "jr_tooltip_text"

screen jr_page(scroll_id, x, width, yinitial = 0.0):
    # """
    # One page column. Layouts are planned to fit, but if content ever runs
    # past the bottom of the page the column scrolls instead of spilling out;
    # the pencil scrollbar only appears in that case.
    #
    # ### Parameters:
    # 1. scroll_id: str
    #     - unique viewport id (keeps the scroll position per column)
    # 2. x: int
    #     - left edge of the column
    # 3. width: int
    #     - content width; the scrollbar sits in the margin to its right
    # """

    side "c r":
        pos (x, JR_TOP_Y)
        xsize width + 18
        ysize JR_BOTTOM_Y - JR_TOP_Y
        spacing 8

        viewport id scroll_id:
            xsize width
            yinitial yinitial
            mousewheel True
            draggable "touch"
            transclude

        vbar value YScrollValue(scroll_id) style "jr_vscrollbar"

screen jr_zoom_overlay(image_path):
    # """
    # A photo enlarged over the whole journal, undistorted; a click anywhere or
    # ESC closes it. The page screen keeps `default zoomed_image = None` and
    # draws this last; buttons open it with SetScreenVariable("zoomed_image", path).
    # """

    button:
        xysize (1920, 1080)
        background Solid("#0b0806e0")
        action SetScreenVariable("zoomed_image", None)
        add Transform(image_path, fit = "contain", xysize = (1840, 1040)) align (0.5, 0.5)
    key "K_ESCAPE" action SetScreenVariable("zoomed_image", None)

screen jr_rubric(label, width):
    # """
    # Small tracked caps heading with a thin rule, like a pre-printed organizer.
    # """

    side "l c":
        xsize width
        spacing 10
        text label.upper() style "jr_rubric" yalign 0.5
        add Transform(Solid(JR_ACCENT + "90"), ysize = 1) yalign 0.6

screen jr_double_rule(width):
    vbox:
        spacing 3
        add Solid(JR_PRINT + "c8") xysize (width, 2)
        add Solid(JR_PRINT + "78") xysize (width, 1)

screen jr_value_bar(value, max_value = 100, small = False):
    # """
    # Pencil-hatched value bar; the hatching is cropped to the value.
    # """

    $ prefix = "gui/journal/ui/bar_small" if small else "gui/journal/ui/bar"
    bar:
        value StaticValue(min(max(value, 0), max_value), max_value)
        xysize ((150, 14) if small else (210, 18))
        left_bar prefix + "_full.webp"
        right_bar prefix + "_empty.webp"
        thumb None
        bar_resizing False
        yalign 0.5

screen jr_leader(x0, x1, row_height = 32):
    # """
    # Dotted ledger leader between a label (ending at x0) and a figure
    # (starting at x1). Rows must be 32px high: the dot sits on the baseline
    # of 22px text in leader.webp.
    # """

    $ gap = 8
    if x1 - x0 > gap * 3:
        add Tile("gui/journal/ui/leader.webp") xpos int(x0 + gap) xysize (int(x1 - x0 - gap * 2), row_height)

screen jr_level_boxes(level, count = 10):
    hbox:
        spacing 3
        yalign 0.5
        for i in range(count):
            add ("gui/journal/ui/box_full.webp" if i < level else "gui/journal/ui/box_empty.webp")

