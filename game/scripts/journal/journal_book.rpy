##############################################################################
# Journal book: the leather planner every journal page is drawn into.
#
# Layer order (back to front):
#   journal_backdrop   blurred map, stat HUD, warm vignette
#   book_cover         leather, stitching, spine
#   ribbons            navigation bookmarks, tucked under the pages
#   book_pages         paper, page stacks, rings
#   page content       drawn by the individual journal screens
#
# Graphics are generated by tools/journal_assets/*.py; the page rectangles
# below must match LEFT_PAGE / RIGHT_PAGE in build_book.py.
##############################################################################

#########################
# region Journal Design #
#########################

# printed planner text, rubric red, typewriter ribbon, pencil
define JR_PRINT = "#342820"
define JR_ACCENT = "#8a2622"
define JR_TYPED = "#262428"
define JR_PENCIL = "#706a60"
define JR_GREEN = "#34603a"

# before the styles below: jr_text uses it
init -1 python:
    def journal_link_styler(target):
        return style.jr_link_text

    # same click/sensitivity handling as Ren'Py's defaults, only the look differs
    jr_hyperlinks = (journal_link_styler, hyperlink_function, None, hyperlink_sensitive)

define JR_FONT = "fonts/CrimsonPro-Regular.ttf"
define JR_FONT_MEDIUM = "fonts/CrimsonPro-Medium.ttf"
define JR_FONT_SEMIBOLD = "fonts/CrimsonPro-SemiBold.ttf"
define JR_FONT_BOLD = "fonts/CrimsonPro-Bold.ttf"
define JR_FONT_TYPED = "fonts/SpecialElite-Regular.ttf"

# usable writing area of both pages (inside margins, clear of the spine shadow)
define JR_LEFT_X = 336
define JR_LEFT_W = 560
define JR_RIGHT_X = 1036
define JR_RIGHT_W = 552
define JR_TOP_Y = 168
define JR_BOTTOM_Y = 1000

style jr_text:
    font JR_FONT
    color JR_PRINT
    size 26
    hyperlink_functions jr_hyperlinks

style jr_title is jr_text:
    font JR_FONT_SEMIBOLD
    size 54

style jr_rubric is jr_text:
    font JR_FONT_BOLD
    color JR_ACCENT
    size 17
    kerning 2.2

style jr_label is jr_text

style jr_value is jr_text:
    font JR_FONT_BOLD

style jr_body is jr_text:
    size 23
    line_spacing 6

style jr_small is jr_text:
    size 20
    color JR_PENCIL

style jr_typed is jr_text:
    font JR_FONT_TYPED
    color JR_TYPED
    size 21
    line_spacing 6

style jr_typed_small is jr_typed:
    size 17
    color JR_PENCIL

# {a} links inside journal text: the game's hyperlink_text style uses the GUI font,
# so journal texts swap in this one via hyperlink_functions (see jr_hyperlinks)
style jr_link_text:
    # a link takes ALL properties from this style, size included; journal links
    # only appear in small print (jr_small), so it matches that size
    font JR_FONT_SEMIBOLD
    size 20
    color JR_ACCENT
    hover_color "#000"
    hover_underline True

# entries on a page: pencil underline on hover, marker swipe when selected
style jr_entry_button:
    background None
    hover_background Frame("gui/journal/ui/underline.webp", 10, 26, 10, 6)
    selected_background Frame("gui/journal/ui/highlight.webp", 12, 0, 12, 0)
    selected_hover_background Frame("gui/journal/ui/highlight.webp", 12, 0, 12, 0)
    padding (6, 0, 8, 0)

style jr_entry_button_text is jr_label:
    hover_color "#000"

# Touch screens: a finger needs bigger targets than a mouse pointer. Only the padding
# grows, so the page layouts stay as they are on PC.
style jr_entry_button:
    variant "touch"
    padding (12, 8, 14, 8)

# Phones: the 1920x1080 page is shrunk to a few inches, so the small print grows a
# little (columns that run long scroll, see jr_page).
style jr_small:
    variant "small"
    size 23

style jr_typed_small:
    variant "small"
    size 20

style jr_rubric:
    variant "small"
    size 19

style jr_body:
    variant "small"
    size 25

# graphite-stroke thumb on a dotted pencil guide line; hidden while nothing overflows
style jr_vscrollbar:
    xsize 10
    base_bar Tile("gui/journal/ui/scroll_track.webp")
    thumb Frame("gui/journal/ui/scroll_thumb.webp", 0, 12, 0, 12)
    thumb_offset 0
    unscrollable "hide"

style jr_tooltip_frame:
    background Frame("gui/journal/ui/slip.webp", 8, 8, 12, 12)
    padding (16, 10, 22, 16)

style jr_tooltip_text is jr_text:
    size 21

transform jr_map_blur:
    blur 8

# ribbons slide a little further out of the book on hover
transform jr_ribbon_slide(dx):
    on idle:
        easein 0.15 xoffset 0
    on hover:
        easein 0.15 xoffset dx

transform jr_sub_slide:
    on idle:
        easein 0.15 yoffset 0
    on hover:
        easein 0.15 yoffset -8

init python:
    # key, tooltip, journal page (None = placeholder), shortcut digit
    JOURNAL_NAV_LEFT = [
        ("overview", "School Overview", 1, "1"),
        ("characters", "Characters", 9, "9"),
        ("unlockables", "Unlockables", 4, "5"),
        ("situations", "Situations", 8, "2"),
        ("inventory", "Inventory", 2, "3"),
        ("collectibles", "Collectibles", 12, "4"),
    ]
    JOURNAL_NAV_RIGHT = [
        ("gallery", "Replay Gallery", 7, "7"),
        ("credits", "Credits", 6, "6"),
        ("cheats", "Cheats", 5, "8"),
        ("menu", "Game Menu", 11, None),
    ]
    JOURNAL_PAGE_SECTION = {
        1: "overview", 3: "overview", 9: "characters", 4: "unlockables", 8: "situations",
        2: "inventory", 10: "inventory", 7: "gallery", 6: "credits", 5: "cheats",
        11: "menu", 12: "collectibles",
    }
    # the only sections usable while the journal is open as the game menu mid event
    JOURNAL_GAME_MENU_SECTIONS = ("menu", "cheats")
    # the only sections on the journal opened from the title screen
    JOURNAL_TITLE_SECTIONS = ("menu", "credits")
    # Pencil doodles per section: (doodle, x, y) in screen pixels, drawn under the page
    # content. Kept to one or two per spread and placed where that page usually stays
    # empty (mostly the lower left page). Images: tools/journal_assets/build_doodles.py
    JOURNAL_DOODLES = {
        "overview": [("coffee_ring", 1418, 846), ("star_red", 862, 178)],
        # heart between the group title and the head count; smiley in the empty last
        # roster slot of a 15-girl class
        "characters": [("heart_red", 636, 170), ("smiley", 792, 880)],
        "situations": [("flask", 386, 868), ("tally", 560, 928)],
        "unlockables": [("word_fri", 384, 912), ("stars_trio", 736, 884)],
        "inventory": [("tictactoe", 398, 858), ("paper_plane", 700, 900)],
        "gallery": [("word_wow", 382, 904), ("heart_hatched", 566, 902)],
        "credits": [("heart_red", 812, 930)],
        "cheats": [("word_shh", 400, 904), ("lightning", 826, 862)],
    }

    JOURNAL_RIBBON_ROWS = [262, 362, 462, 562, 662, 762]
    JOURNAL_EXIT_ROW = 900

    import functools

    # leader rows measure their texts on every screen evaluation (each hover);
    # the same label in the same style always has the same width
    @functools.lru_cache(maxsize = 2048)
    def journal_text_width(s: str, style: str = "jr_text", **properties) -> int:
        """
        Rendered width of a text, so leader dots can run exactly up to it.
        """

        return Text(s, style = style, **properties).size()[0]

    def journal_section_has_alert(section: str) -> bool:
        """
        Whether a ribbon's section has unseen changes (any journal alert topic
        whose primary page belongs to it, see journal_alerts.rpy).
        """

        for topic in JOURNAL_ALERT_TOPICS.values():
            if JOURNAL_PAGE_SECTION.get(topic.page) == section and journal_has_alert(topic.key):
                return True
        return False

    def journal_nav_entries(side):
        entries = JOURNAL_NAV_LEFT if side == "l" else JOURNAL_NAV_RIGHT
        return [entry for entry in entries if entry[0] != "cheats" or cheat_mode]

# endregion
